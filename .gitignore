# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 雛形だけは追跡する。README のセットアップ手順がこれを配る前提になっている。
!.env.example

# vercel
.vercel

# DBバックアップ。購読内容や記事が入るので追跡しない。
/backups

# typescript
*.tsbuildinfo
next-env.d.ts
