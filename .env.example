# Supabase（Project Settings > API Keys から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ダッシュボードの「Publishable key」。sb_publishable_ で始まる。
# 旧称は anon key。ブラウザに渡るので NEXT_PUBLIC_ が必要。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ダッシュボードの「Secret key」。sb_secret_ で始まる。旧称は service_role key。
# サーバー専用。RLSを迂回するのでクライアントに絶対渡さない。
# cron/ワーカーのルートだけで使う。
SUPABASE_SECRET_KEY=

# DBへの直接接続。アプリは使わない。npm run db:migrate / db:backup 用。
# ダッシュボード上部の「Connect」ボタン > Session pooler の URI をそのまま貼る。
# （Transaction pooler の 6543 は DDL に使えないことがあるので避ける）
# パスワード部分は [YOUR-PASSWORD] のままでよい。
SUPABASE_DB_URL=

# 上の URL に埋めるパスワード。記号もそのまま書く（エンコード不要）。
# 忘れた場合は Project Settings > Database > Reset database password で再発行できる。
SUPABASE_DB_PASSWORD=

# cron/ワーカーのルートを叩くための共有シークレット。
# pg_cron と Vercel Cron からの Authorization: Bearer に載せる。
CRON_SECRET=

# ワーカーが動くときの対象ユーザー。バックグラウンド処理には
# ログインセッションが無いので、自分のuidを固定で指定する。
# Supabase の Authentication > Users から自分のUUIDをコピーする。
OWNER_USER_ID=

# ログインを許すメールアドレス（カンマ区切り）。空なら制限しない。
# これ以外のアドレスにはマジックリンクを送らない。ただしアプリを通った場合だけの
# 話で、公開鍵で Supabase の auth API を直接叩かれる経路はこれでは塞げない。
# 新規サインアップは Supabase の Authentication 設定側でも必ずオフにすること。
ALLOWED_EMAILS=

# Gemini API（https://aistudio.google.com/apikey）
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_SCRIPT_MODEL=gemini-3.5-flash

# Google Drive 連携（P2）。Google Cloud Console でOAuthクライアントを作る。
# スコープは drive.file（自アプリが作ったファイルのみ）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
